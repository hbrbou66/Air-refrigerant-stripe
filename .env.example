# ---------------------------------------------------------------------------
# Air Refrigerant Stripe storefront
# Copy this file to .env.local for local development.
# Add the same values in Vercel → Project → Settings → Environment Variables.
# ---------------------------------------------------------------------------

# Required in the browser to load Stripe's secure embedded payment form.
# Publishable by design; use pk_test_... locally, then pk_live_... in production.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Required for payments. Use sk_test_... locally, then sk_live_... in production.
# Server-side only — never prefix this value with NEXT_PUBLIC.
STRIPE_SECRET_KEY=

# Canonical public site URL used by SEO and Stripe return URLs.
NEXT_PUBLIC_SITE_URL=https://airrefrigerant.site

# ---------------------------------------------------------------------------
# Lead delivery (contact + bulk-quote forms) via Resend — optional.
# ---------------------------------------------------------------------------
RESEND_API_KEY=
LEAD_TO_EMAIL=
# Must be a verified sender on your Resend domain.
LEAD_FROM_EMAIL=

# Meta (Facebook) Pixel — optional override.
NEXT_PUBLIC_FB_PIXEL_ID=
